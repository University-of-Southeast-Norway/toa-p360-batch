{
  "InProductionDate": "2023-01-01", // yyyy-MM-dd.
  "LogFolder": "c:/temp/",
  "ReportFolder": "c:/temp/",
  "StateFolder": "state",
  "P360": {
    "AdContextUser": "swi\\360integration", // Optional, this is the default.
    // Direct to P360 (used when 'CaseService' is not set):
    "BaseAddress": "https://<institution>.public360online.com", // TEST: https://<institution>.public360online.com
    "ApiKey": "",
    // Through IntArk (used when 'CaseService' is set):
    "CaseService": {
      "BaseAddress": "https://gw-<institution>.intark.uh-it.no/<P360 API path til CaseService>/",
      "ApiKey": ""
    },
    "DocumentService": {
      "BaseAddress": "https://gw-<institution>.intark.uh-it.no/<P360 API path til DocumentService>/",
      "ApiKey": ""
    },
    "ContactService": {
      "BaseAddress": "https://gw-<institution>.intark.uh-it.no/<P360 API path til ContactService>/",
      "ApiKey": ""
    },
    "SupportService": {
      "BaseAddress": "https://gw-<institution>.intark.uh-it.no/<P360 API path til SupportService>/",
      "ApiKey": ""
    }
  },
  "Dfo": {
    "Api_Base": "https://api.dfo.no/" // TEST: https://api-test.dfo.no/
  },
  "Maskinporten": { // This part is not required if 'Api_Keys' is set
    "Certificate": {
      "Path": "", // Get certificate from organization
      "Password": "" // Get password from organization
    },
    "Audience": "https://maskinporten.no/", // TEST: https://ver2.maskinporten.no/
    "TokenEndpoint": "https://maskinporten.no/token", // TEST: https://ver2.maskinporten.no/
    "Issuer": "", // Get from samarbeidsportalen
    "Scope": "dfo:ansatte dfo:ansatte/infokontrakter dfo:infokontrakter/filer"
  },
  "Api_Keys": [
    {
      "Scope": "dfo:ansatte",
      "Header": "X-Gravitee-Api-Key",
      "Value": ""
    },
    {
      "Scope": "dfo:ansatte/infokontrakter",
      "Header": "X-Gravitee-Api-Key",
      "Value": ""
    },
    {
      "Scope": "dfo:infokontrakter/filer",
      "Header": "X-Gravitee-Api-Key",
      "Value": ""
    }
  ]
}
